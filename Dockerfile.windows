# =============================================================================
# Helix 런타임 컨테이너 (Windows) — Phase 3 스캐폴드
#
# 주의: 엔진은 현재 Windows 전용(IOCP)이므로 Windows 컨테이너로 패키징한다.
#       Linux(epoll) 이미지는 Phase 4에서 추가된다.
#
# 이 Dockerfile은 "런타임 패키징" 방식이다 — 먼저 호스트/CI에서 빌드한 뒤
# 산출물을 이미지에 담는다(이미지에 MSVC 툴체인을 넣지 않아 가볍다):
#   cmake --preset windows-x64
#   cmake --build --preset windows-release
#   docker build -f Dockerfile.windows -t helix:dev .
#   docker run --rm -p 5000:5000 -e HELIX_LOGGING__LEVEL=debug helix:dev
#
# 설정은 환경변수로 주입(12-factor): HELIX_<SECTION>__<KEY>
# =============================================================================

FROM mcr.microsoft.com/windows/servercore:ltsc2022

WORKDIR C:\\helix

# 빌드 산출물 + 기본 설정. (VC++ 런타임이 필요하면 별도 설치 단계 추가)
COPY build/windows-x64/Release/helix_echo_phase1.exe ./helix.exe
COPY config/ ./config/

ENV HELIX_LOGGING__SINK=stdout

EXPOSE 5000

# stdout 로그 → 컨테이너 로그 수집기로. SIGTERM graceful drain은 Phase 4.
ENTRYPOINT ["C:\\helix\\helix.exe"]

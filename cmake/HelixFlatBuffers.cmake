include_guard(GLOBAL)
include(FetchContent)
if(POLICY CMP0135)
	cmake_policy(SET CMP0135 NEW)
endif()
FetchContent_Declare(helix_flatbuffers
	URL https://github.com/google/flatbuffers/archive/refs/tags/v25.2.10.zip
	URL_HASH SHA256=75ffbce7d32f8218b5faec86ae2f6397c7ca810605dc710dfa9c146b9df9e3e9
	SOURCE_SUBDIR helix_headers_only)
FetchContent_MakeAvailable(helix_flatbuffers)
set(HELIX_FLATC_EXECUTABLE "" CACHE FILEPATH "Optional official flatc 25.2.10; empty builds the pinned compiler")
if(HELIX_FLATC_EXECUTABLE)
	execute_process(COMMAND "${HELIX_FLATC_EXECUTABLE}" --version OUTPUT_VARIABLE _flatc_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
	if(NOT _flatc_version STREQUAL "flatc version 25.2.10")
		message(FATAL_ERROR "flatc must match FlatBuffers 25.2.10")
	endif()
	set(HELIX_FLATC_COMMAND "${HELIX_FLATC_EXECUTABLE}")
	set(HELIX_FLATC_DEPENDENCY "${HELIX_FLATC_EXECUTABLE}")
else()
	set(FLATBUFFERS_BUILD_TESTS OFF CACHE BOOL "" FORCE)
	set(FLATBUFFERS_BUILD_FLATLIB OFF CACHE BOOL "" FORCE)
	set(FLATBUFFERS_BUILD_FLATC ON CACHE BOOL "" FORCE)
	set(FLATBUFFERS_INSTALL OFF CACHE BOOL "" FORCE)
	add_subdirectory("${helix_flatbuffers_SOURCE_DIR}" "${helix_flatbuffers_BINARY_DIR}")
	set(HELIX_FLATC_COMMAND "$<TARGET_FILE:flatc>")
	set(HELIX_FLATC_DEPENDENCY flatc)
endif()

include_guard(GLOBAL)

# Keep both the root preset and the independent cpp/ solution organized.
set_property(GLOBAL PROPERTY USE_FOLDERS ON)
set_property(GLOBAL PROPERTY PREDEFINED_TARGETS_FOLDER "99 CMake")

function(helix_group_ide_targets directory)
	get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
	foreach(_target IN LISTS _targets)
		get_target_property(_type "${_target}" TYPE)
		get_target_property(_source_dir "${_target}" SOURCE_DIR)
		file(TO_CMAKE_PATH "${_source_dir}" _source_dir)

		if(_target STREQUAL "helix" OR _target STREQUAL "helix_capi")
			set(_folder "01 Engine")
		elseif(_target MATCHES "^helix(_|$)")
			if(_target MATCHES "_test$")
				set(_folder "04 Tests")
			elseif(_target MATCHES "(_benchmark|_allocation_probe)$")
				set(_folder "05 Benchmarks")
			elseif(_type MATCHES "_LIBRARY$")
				set(_folder "02 Modules")
			else()
				set(_folder "03 Samples")
			endif()
		elseif(_target MATCHES "^(Continuous|Experimental|Nightly)")
			set(_folder "99 CMake/CTest")
		elseif(_source_dir MATCHES "/(absl|abseil)[^/]*(/|$)")
			set(_folder "90 Dependencies/Abseil")
		elseif(_source_dir MATCHES "/[^/]*protobuf[^/]*(/|$)")
			set(_folder "90 Dependencies/Protobuf")
		elseif(_source_dir MATCHES "/[^/]*flatbuffers[^/]*(/|$)")
			set(_folder "90 Dependencies/FlatBuffers")
		else()
			set(_folder "90 Dependencies")
		endif()
		set_property(TARGET "${_target}" PROPERTY FOLDER "${_folder}")
	endforeach()

	get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
	foreach(_child IN LISTS _children)
		helix_group_ide_targets("${_child}")
	endforeach()
endfunction()

# Protobuf는 네트워크 코어의 의존성이 아니라 선택 프로토콜 프로젝트의 의존성이다.
include(FetchContent)
set(HELIX_PROTOBUF_VERSION "36.2")
if(POLICY CMP0135)
	cmake_policy(SET CMP0135 NEW)
endif()
find_package(Protobuf 36.2.0 EXACT CONFIG QUIET)
if(NOT TARGET protobuf::libprotobuf OR NOT TARGET protobuf::protoc)
	set(HELIX_PROTOC_EXECUTABLE "" CACHE FILEPATH "Matching host protoc; empty downloads the pinned compiler")
	if(NOT HELIX_PROTOC_EXECUTABLE)
		if(CMAKE_HOST_WIN32)
			set(_helix_protoc_platform "win64")
		elseif(CMAKE_HOST_APPLE)
			if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
				set(_helix_protoc_platform "osx-aarch_64")
			else()
				set(_helix_protoc_platform "osx-x86_64")
			endif()
		elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
			set(_helix_protoc_platform "linux-aarch_64")
		else()
			set(_helix_protoc_platform "linux-x86_64")
		endif()
		FetchContent_Declare(helix_protoc
			URL "https://github.com/protocolbuffers/protobuf/releases/download/v${HELIX_PROTOBUF_VERSION}/protoc-${HELIX_PROTOBUF_VERSION}-${_helix_protoc_platform}.zip"
		)
		FetchContent_MakeAvailable(helix_protoc)
		if(CMAKE_HOST_WIN32)
			set(HELIX_PROTOC_EXECUTABLE "${helix_protoc_SOURCE_DIR}/bin/protoc.exe")
		else()
			set(HELIX_PROTOC_EXECUTABLE "${helix_protoc_SOURCE_DIR}/bin/protoc")
		endif()
	endif()
	execute_process(COMMAND "${HELIX_PROTOC_EXECUTABLE}" --version
		OUTPUT_VARIABLE _helix_protoc_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
	if(NOT _helix_protoc_version STREQUAL "libprotoc ${HELIX_PROTOBUF_VERSION}")
		message(FATAL_ERROR "Host protoc must match Protobuf ${HELIX_PROTOBUF_VERSION}; got ${_helix_protoc_version}")
	endif()
	set(WITH_PROTOC "${HELIX_PROTOC_EXECUTABLE}" CACHE FILEPATH "Host compiler for Protobuf" FORCE)
	if(TARGET protobuf::libprotobuf)
		# Installed runtime packages may omit protoc; supply only the host compiler.
		add_executable(helix_protoc_host IMPORTED GLOBAL)
		set_target_properties(helix_protoc_host PROPERTIES IMPORTED_LOCATION "${HELIX_PROTOC_EXECUTABLE}")
		add_executable(protobuf::protoc ALIAS helix_protoc_host)
		return()
	endif()
	set(protobuf_BUILD_TESTS OFF CACHE BOOL "" FORCE)
	set(protobuf_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
	set(protobuf_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
	set(protobuf_MSVC_STATIC_RUNTIME OFF CACHE BOOL "" FORCE)
	set(protobuf_WITH_ZLIB OFF CACHE BOOL "" FORCE)
	set(protobuf_BUILD_LIBUPB OFF CACHE BOOL "" FORCE)
	set(protobuf_INSTALL ON CACHE BOOL "" FORCE)
	if(MSVC)
		# Upstream headers contain UTF-8; apply to fetched dependency targets too.
		add_compile_options(/utf-8)
	endif()
	FetchContent_Declare(helix_protobuf
		URL "https://github.com/protocolbuffers/protobuf/releases/download/v${HELIX_PROTOBUF_VERSION}/protobuf-${HELIX_PROTOBUF_VERSION}.tar.gz"
		URL_HASH SHA256=3d9642a662d10e68ebae5e53f14dcce5105684212d5078f8e0d47d1ab3ae6b64
	)
	FetchContent_MakeAvailable(helix_protobuf)
	install(FILES "${helix_protobuf_SOURCE_DIR}/LICENSE" DESTINATION share/helix/licenses RENAME protobuf-LICENSE)
	install(FILES "${helix_protobuf_SOURCE_DIR}/third_party/utf8_range/LICENSE" DESTINATION share/helix/licenses RENAME utf8_range-LICENSE)
	FetchContent_GetProperties(absl)
	if(absl_SOURCE_DIR)
		install(FILES "${absl_SOURCE_DIR}/LICENSE" DESTINATION share/helix/licenses RENAME abseil-LICENSE)
	endif()
endif()

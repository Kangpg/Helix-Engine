<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>Helix.Protocol.MemoryPack</PackageId><Version>0.4.0</Version>
		<Description>Optional C#-only MemoryPack packet serializer for Helix.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
